# Example configuration for LISA Scheduler
# Copy this to your Home Assistant configuration.yaml and modify as needed.

lisa_scheduler:
  # Required: URL of your club's schedule page.
  schedule_url: "https://www.your-club.com/schedule"

  # Optional: minutes before event start when HA events should fire.
  # The largest value also determines when the pre-event window opens.
  # Default: [120]
  pre_event_triggers:
    - 120
    - 30

  # Optional: how often to refresh the schedule from the website, in seconds.
  # Default: 21600 (6 hours)
  # Minimum: 600 (10 minutes)
  # Maximum: 86400 (24 hours)
  scan_interval: 21600

  # Optional: enable or disable the scheduler.
  # Default: true
  enabled: true

  # Optional: dry run mode logs transitions without firing HA events.
  # Default: false
  dry_run: false


# Optional: enable debug logging to troubleshoot scraper issues.
logger:
  default: info
  logs:
    custom_components.lisa_scheduler: debug


# Example automation: notify when a pre-event trigger fires.
automation:
  - alias: "LISA: notify before club event"
    trigger:
      - platform: event
        event_type: lisa_scheduler_pre_event_trigger
        event_data:
          minutes_before: 30
    action:
      - service: notify.mobile_app
        data:
          title: "Club event soon"
          message: "An event starts in 30 minutes."


# Example script: create a temporary manual activity window.
script:
  emergency_club_activity:
    alias: "Emergency Club Activity Window (2 hours)"
    icon: mdi:calendar-clock
    sequence:
      - service: lisa_scheduler.set_override
        data:
          start_time: "{{ now().isoformat() }}"
          end_time: "{{ (now() + timedelta(hours=2)).isoformat() }}"
