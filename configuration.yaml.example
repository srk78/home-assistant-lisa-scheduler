# Example configuration for LISA Scheduler.

lisa_scheduler:
  # Required: lisa-schedule-api base URL or full /v1/events endpoint.
  api_url: "https://schedule.example.com"

  # Optional: include away and other external-venue events.
  # Default: false (only events classified at the club venue).
  include_external_events: false

  # Optional: minutes before event start when HA events should fire.
  # The largest value also determines when the pre-event window opens.
  pre_event_triggers:
    - 120
    - 30

  # Optional day-boundary trigger lists.
  pre_first_event_triggers: [60]
  pre_last_event_end_triggers: [15]
  post_last_event_triggers: [10]

  # Optional API polling interval in seconds.
  # Default/minimum: 600 (10 minutes); maximum: 86400 (24 hours).
  scan_interval: 600

  enabled: true
  dry_run: false


# Debug logging helps diagnose API reachability and contract errors.
logger:
  default: info
  logs:
    custom_components.lisa_scheduler: debug


# Example automation: notify when a pre-event trigger fires.
automation:
  - alias: "LISA: notify before club event"
    trigger:
      - platform: event
        event_type: lisa_scheduler_pre_event_trigger
        event_data:
          minutes_before: 30
    action:
      - service: notify.mobile_app
        data:
          title: "Club event soon"
          message: "An event starts in 30 minutes."


# Example script: create a temporary manual activity window.
script:
  emergency_club_activity:
    alias: "Emergency Club Activity Window (2 hours)"
    icon: mdi:calendar-clock
    sequence:
      - service: lisa_scheduler.set_override
        data:
          start_time: "{{ now().isoformat() }}"
          end_time: "{{ (now() + timedelta(hours=2)).isoformat() }}"
